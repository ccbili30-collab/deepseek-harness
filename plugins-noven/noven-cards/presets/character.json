{
  "id": "character",
  "kind": "CHARACTER",
  "title": "角色卡",
  "summary": "一张空白角色卡：基本信息、关系、行动轨迹。其余按需让 AI 现造。",
  "defaultName": "未命名角色",
  "modules": [
    {
      "name": "基本信息",
      "widget": "collection",
      "view": "profile",
      "fields": [
        {
          "name": "姓名",
          "type": "text"
        },
        {
          "name": "形象",
          "type": "image"
        },
        {
          "name": "身份",
          "type": "text"
        },
        {
          "name": "年龄",
          "type": "number"
        },
        {
          "name": "阵营",
          "type": "text"
        },
        {
          "name": "出身",
          "type": "text"
        },
        {
          "name": "一句话",
          "type": "text"
        },
        {
          "name": "性格关键词",
          "type": "chips"
        },
        {
          "name": "档案",
          "type": "longtext"
        }
      ]
    },
    {
      "name": "关系",
      "widget": "collection",
      "view": "graph",
      "fields": [
        {
          "name": "从",
          "type": "text"
        },
        {
          "name": "到",
          "type": "text"
        },
        {
          "name": "关系",
          "type": "text"
        },
        {
          "name": "说明",
          "type": "longtext"
        }
      ]
    },
    {
      "name": "行动轨迹",
      "widget": "timeline",
      "timeline": {
        "unit": "岁",
        "view": "diary"
      }
    }
  ]
}
