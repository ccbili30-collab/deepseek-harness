{
  "name": "noven-cards",
  "version": "0.1.0",
  "description": "Noven cards — the mobile card system ported: two card kinds on one modular base, project-local store, full AI card-management tools, exchange import/export.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./selection": {
      "types": "./lib/selection.d.ts",
      "default": "./lib/selection.js"
    }
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node tests/round-trip.mjs && node tests/proposals.mjs && node tests/selection.mjs && node tests/routes.mjs && node tests/map.mjs && node tests/presets.mjs && node tests/module-presets.mjs && node tests/image-width.mjs && node tests/ai-interface.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/pngjs": "^6.0.5",
    "noven-fmg": "workspace:*",
    "noven-ledger": "workspace:*",
    "pngjs": "7.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
