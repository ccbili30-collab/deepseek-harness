{
  "name": "noven-sidecar",
  "version": "0.1.0",
  "description": "Noven sidecar — 常驻设定管理员：noven-sidecar preset 的真会话（管理员人设+实体工具），消化循环按轮投递整理任务；项目级实体库，/api/noven-sidecar 供给侧栏 pane。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./entities": {
      "types": "./lib/entities.d.ts",
      "default": "./lib/entities.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.7-rc.1",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "noven-ledger": "workspace:*"
  }
}
