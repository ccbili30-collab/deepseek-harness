{
  "name": "noven-fmg",
  "version": "0.1.0",
  "description": "Noven world-map engine — deterministic generation pipeline and geometry derived from Azgaar's Fantasy-Map-Generator (MIT).",
  "type": "module",
  "exports": {
    "./mapgeom": {
      "types": "./lib/mapgeom.d.ts",
      "default": "./lib/mapgeom.js"
    },
    "./world": {
      "types": "./lib/world/index.d.ts",
      "default": "./lib/world/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node tests/world-gen.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/delaunator": "^5.0.3",
    "@types/polylabel": "^1.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "alea": "^1.0.1",
    "d3": "^7.9.0",
    "delaunator": "^5.1.0",
    "polylabel": "^2.1.0",
    "tinyqueue": "^3.0.0"
  }
}
