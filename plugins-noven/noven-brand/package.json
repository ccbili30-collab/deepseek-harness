{
  "name": "noven-brand",
  "version": "0.1.0",
  "description": "Noven brand — sidebar logo mark and name for the Noven desktop product.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  }
}
